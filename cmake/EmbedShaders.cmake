# Writes a .cpp that holds every Shaders/**/*.glsl as a byte array, so the
# executables don't need the GLSL files next to them (and none are shipped).
#
# Run at build time: cmake -DSHADER_DIR=<dir> -DOUTPUT=<file.cpp> -P EmbedShaders.cmake
#
# Byte arrays, not string literals: MSVC limits a string literal to ~16 KB a
# piece and Rendering.vs.glsl is bigger than that.

if(NOT SHADER_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "EmbedShaders.cmake needs SHADER_DIR and OUTPUT")
endif()

file(GLOB_RECURSE shader_files RELATIVE "${SHADER_DIR}" "${SHADER_DIR}/*.glsl")
list(SORT shader_files)

# 32 bytes (64 hex digits) per line keeps the lines short.
string(REPEAT "[0-9a-f]" 64 hex_line_pattern)

set(arrays "")
set(entries "")
set(index 0)

foreach(shader IN LISTS shader_files)
    file(READ "${SHADER_DIR}/${shader}" hex HEX)
    file(SIZE "${SHADER_DIR}/${shader}" size)

    string(REGEX REPLACE "(${hex_line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")

    # A 0 after the text, so the data can also be used as a C string.
    string(APPEND arrays "// ${shader}\nconstexpr unsigned char SHADER_${index}[] = {\n${hex}\n0x00};\n\n")
    string(APPEND entries "    {\"${shader}\", SHADER_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/EmbedShaders.cmake from Shaders/. Don't edit: edit the .glsl.

#include \"Headers/Runtime/Renderer/EmbeddedShaders.hpp\"

#include <cstddef>

namespace {

${arrays}struct Entry {
    std::string_view path;
    const unsigned char* data;
    std::size_t size;
};

constexpr Entry ENTRIES[] = {
${entries}};

} // namespace

std::optional<std::string_view> EmbeddedShaders::Find(const std::string_view path) {
    for (const Entry& entry : ENTRIES)
        if (entry.path == path) return std::string_view(reinterpret_cast<const char*>(entry.data), entry.size);
    return std::nullopt;
}
")

# Only rewritten when it changes, so an unchanged shader set compiles nothing.
set(old_content "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old_content)
endif()
if(NOT old_content STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
